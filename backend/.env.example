# Use the PostgreSQL connection URL from Supabase Connect. Never commit the real password.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Trusted web origins, separated by commas.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Add these when enabling real Supabase authentication.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=