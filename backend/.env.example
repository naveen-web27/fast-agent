# Use Supabase's *pooler* connection string (Settings -> Database -> Connection pooling),
# not the direct db.PROJECT.supabase.co host - that host is IPv6-only and unreachable from
# Render. Never commit the real password.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Trusted web origins, separated by commas.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Add these when enabling real Supabase authentication.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Required to email one-time codes for company email/domain verification.
# Sign up free at https://resend.com, create an API key, and verify a sending domain
# (or use the resend.dev sandbox address for testing).
RESEND_API_KEY=
RESEND_FROM_EMAIL=RightConnect <onboarding@resend.dev>