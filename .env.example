# ---- Database ----
# Runtime SQLite file for conversation history and ratings; client details are in data/clients.csv.
# Change the path if you want the .db file somewhere else.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---- OpenAI ----
# Plug in your OpenAI API key here. Used ONLY for intent classification / entity extraction,
# never to fabricate business data (price, stock, orders).
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ---- Meta WhatsApp Cloud API ----
# Plug in your Meta app's permanent/temporary access token here.
WHATSAPP_TOKEN=your-meta-whatsapp-access-token
# The value you choose and configure in the Meta App webhook subscription (GET /webhook handshake).
WHATSAPP_VERIFY_TOKEN=your-own-verify-token
# Cloud API version used to build the Graph API URLs.
WHATSAPP_API_VERSION=v20.0

# ---- Admin ----
# Simple shared secret to protect the /admin endpoints (mark conversation resolved, etc).
ADMIN_API_KEY=change-me-admin-secret

# ---- App ----
ENV=development
