{
  "id": "/pages/marketplace.html",
  "name": "RightConnect",
  "short_name": "RightConnect",
  "description": "Find and coordinate with trusted experts and companies.",
  "start_url": "/pages/marketplace.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["business", "productivity", "finance"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "play", "url": "https://play.google.com/store/apps/details?id=app.rightconnect.twa", "id": "app.rightconnect.twa" }
  ],
  "background_color": "#f4f6fa",
  "theme_color": "#101b31",
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/rightconnect-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "/assets/screenshots/discover-narrow.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Search verified experts and companies" },
    { "src": "/assets/screenshots/profile-narrow.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Check ratings and reviews before you reach out" },
    { "src": "/assets/screenshots/discover-wide.png", "sizes": "1920x1200", "type": "image/png", "form_factor": "wide", "label": "RightConnect marketplace on desktop" }
  ],
  "shortcuts": [
    { "name": "Find an expert", "url": "/pages/marketplace.html", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "My requests", "url": "/pages/marketplace.html?view=requests", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Dashboard", "url": "/pages/marketplace.html?view=dashboard", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Saved profiles", "url": "/pages/marketplace.html?view=saved", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "/pages/marketplace.html",
    "method": "GET",
    "params": { "title": "title", "text": "q", "url": "url" }
  }
}